@using Transport.Repository.Resource
@{
    Layout = "";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; background: transparent; }

        /* ── Month Pills ── */
        .month-strip { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 0 8px; }
        .mpill {
            padding: 5px 14px; border-radius: 20px;
            border: 1px solid #dee2e6; cursor: pointer;
            font-size: 12px; font-weight: 500;
            background: #fff; color: #555; transition: all .15s; white-space: nowrap;
        }
        .mpill:hover  { border-color: #8e44ad; color: #8e44ad; }
        .mpill.active { background: #8e44ad; border-color: #8e44ad; color: #fff; }

        /* ── Summary Cards ── */
        .sum-cards { display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
        .scard {
            flex: 1; min-width: 140px; border-radius: 12px;
            padding: 14px 16px; color: #fff; position: relative; overflow: hidden;
        }
        .scard::after {
            content: ''; position: absolute; right: -10px; top: -10px;
            width: 70px; height: 70px; border-radius: 50%;
            background: rgba(255,255,255,.12);
        }
        .scard .sc-icon { font-size: 22px; opacity: .85; margin-bottom: 6px; }
        .scard .sc-lbl  { font-size: 10px; opacity: .8; text-transform: uppercase; letter-spacing: .6px; }
        .scard .sc-val  { font-size: 20px; font-weight: 700; margin-top: 2px; }
        .sc-rev  { background: linear-gradient(135deg,#1a9e6e,#27ae60); }
        .sc-exp  { background: linear-gradient(135deg,#a93226,#e74c3c); }
        .sc-net  { background: linear-gradient(135deg,#6c3483,#8e44ad); }
        .sc-marg { background: linear-gradient(135deg,#1a6fa3,#2980b9); }

        /* ── P&L Statement ── */
        .pl-block { border-radius: 10px; overflow: hidden; border: 1px solid #e0e0e0; margin-bottom: 16px; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
        .pl-section-hdr {
            background: linear-gradient(135deg,#2c3e50,#34495e);
            color: #fff; font-weight: 700; font-size: 11px;
            padding: 9px 16px; letter-spacing: .8px; text-transform: uppercase;
            display: flex; align-items: center; gap: 8px;
        }
        .pl-row {
            display: flex; border-bottom: 1px solid #f2f2f2;
            transition: background .1s;
        }
        .pl-row:hover { background: #fafcff; }
        .pl-row:last-child { border-bottom: none; }
        .pl-row .pl-label { flex: 1; padding: 10px 16px; color: #444; }
        .pl-row .pl-icon  { width: 30px; padding: 10px 0 10px 16px; color: #aaa; font-size: 11px; }
        .pl-row .pl-amt   { width: 150px; padding: 10px 16px; text-align: right; font-weight: 600; }

        .pl-subtotal {
            background: #f0f4f8;
            border-top: 2px solid #d0d7e0;
        }
        .pl-subtotal .pl-label { font-weight: 700; color: #2c3e50; font-size: 13px; }
        .pl-subtotal .pl-amt   { font-weight: 700; font-size: 14px; }

        .pl-net {
            background: linear-gradient(135deg,#2c3e50,#34495e);
            color: #fff;
        }
        .pl-net .pl-label { font-weight: 700; font-size: 15px; color: #fff; }
        .pl-net .pl-amt   { font-weight: 700; font-size: 18px; color: #fff; }

        .pl-divider { height: 6px; background: #f8f9fa; border-top: 1px solid #eee; border-bottom: 1px solid #eee; }

        /* ── Chart ── */
        .chart-wrap { padding: 16px; }
        .chart-legend { display: flex; gap: 16px; margin-bottom: 12px; font-size: 11px; }
        .legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 4px; }
        .chart-row { display: flex; align-items: center; margin-bottom: 10px; gap: 8px; }
        .chart-month { width: 70px; font-size: 11px; color: #666; text-align: right; font-weight: 500; }
        .chart-bars  { flex: 1; display: flex; flex-direction: column; gap: 3px; }
        .bar-rev { height: 9px; background: linear-gradient(90deg,#1a9e6e,#27ae60); border-radius: 4px; min-width: 2px; transition: width .6s ease; }
        .bar-exp { height: 9px; background: linear-gradient(90deg,#a93226,#e74c3c); border-radius: 4px; min-width: 2px; transition: width .6s ease; }
        .chart-val { width: 85px; font-size: 11px; color: #666; text-align: right; }

        /* ── Monthly Table ── */
        .ml-tbl { width: 100%; border-collapse: collapse; font-size: 12px; }
        .ml-tbl th { background: #34495e; color: #fff; padding: 8px 10px; border: 1px solid #2c3e50; }
        .ml-tbl th.r { text-align: right; }
        .ml-tbl td { padding: 7px 10px; border: 1px solid #e8e8e8; }
        .ml-tbl tr:nth-child(even) td { background: #f8f9fa; }
        .ml-tbl td.r { text-align: right; font-weight: 600; }
        .ml-tbl tfoot td { background: #2c3e50; color: #fff; font-weight: 700; border: 1px solid #1a252f; }
        .profit { color: #27ae60; }
        .loss   { color: #e74c3c; }

        /* ── Toolbar ── */
        .btn-dl {
            padding: 6px 14px; border: none; border-radius: 6px;
            cursor: pointer; font-size: 12px; font-weight: 600;
            display: inline-flex; align-items: center; gap: 5px;
        }
        .btn-xl  { background: #1e7e34; color: #fff; }
        .btn-pdf { background: #c0392b; color: #fff; }
        .btn-xl:hover  { background: #155724; }
        .btn-pdf:hover { background: #922b21; }

        .loading-box { text-align: center; padding: 50px; color: #aaa; }
        .loading-box i { font-size: 28px; margin-bottom: 10px; display: block; }
        .empty-state { text-align: center; padding: 40px; color: #bbb; }
        .empty-state i { font-size: 32px; display: block; margin-bottom: 8px; }

        @@media print {
            .no-print { display: none !important; }
            body { font-size: 11px; }
            .scard, .pl-section-hdr, .pl-net, .ml-tbl th, .ml-tbl tfoot td, .bar-rev, .bar-exp {
                -webkit-print-color-adjust: exact; print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
<div class="content">
    <div class="container-fluid">

        <!-- Header -->
        <div class="card card-pd mb-3">
            <div class="card-header">
                <span style="font-size:18px;"><i class="fa fa-chart-line"></i></span>
                <span style="font-size:18px; border-left:1px solid #ccc; padding-left:10px;">
                    Profit &amp; Loss Report
                </span>
                <div style="float:right;" class="no-print">
                    <button class="btn-dl btn-xl" onclick="DownloadExcel()">
                        <i class="fa fa-file-excel"></i> Excel
                    </button>
                    &nbsp;
                    <button class="btn-dl btn-pdf" onclick="window.print()">
                        <i class="fa fa-file-pdf"></i> PDF
                    </button>
                </div>
            </div>
            <div class="card-body no-print">
                <div style="font-size:11px;color:#888;font-weight:600;margin-bottom:4px;">
                    <i class="fa fa-calendar-alt"></i> SELECT PERIOD
                </div>
                <div class="month-strip" id="monthStrip"></div>
                <div class="row" style="margin-top:10px;">
                    <div class="col-sm-2">
                        <label style="font-size:11px;color:#666;">From Date</label>
                        <input type="text" id="TxtPLFrom" class="form-control form-control-sm" />
                    </div>
                    <div class="col-sm-2">
                        <label style="font-size:11px;color:#666;">To Date</label>
                        <input type="text" id="TxtPLTo" class="form-control form-control-sm" />
                    </div>
                    <div class="col-sm-2" style="padding-top:18px;">
                        <button class="btn btn-primary btn-sm btn-block" onclick="LoadPLReport()">
                            <i class="fa fa-search"></i> Generate
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="sum-cards no-print" id="summaryCards" style="display:none;">
            <div class="scard sc-rev">
                <div class="sc-icon"><i class="fa fa-arrow-circle-up"></i></div>
                <div class="sc-lbl">Total Revenue</div>
                <div class="sc-val" id="sRevenue">$0.00</div>
            </div>
            <div class="scard sc-exp">
                <div class="sc-icon"><i class="fa fa-arrow-circle-down"></i></div>
                <div class="sc-lbl">Total Expenses</div>
                <div class="sc-val" id="sExpense">$0.00</div>
            </div>
            <div class="scard sc-net" id="netCard">
                <div class="sc-icon"><i class="fa fa-landmark"></i></div>
                <div class="sc-lbl">Net Profit / Loss</div>
                <div class="sc-val" id="sNetProfit">$0.00</div>
            </div>
            <div class="scard sc-marg">
                <div class="sc-icon"><i class="fa fa-percentage"></i></div>
                <div class="sc-lbl">Profit Margin</div>
                <div class="sc-val" id="sMargin">0 %</div>
            </div>
        </div>

        <!-- Loading -->
        <div id="loadingDiv" style="display:none;" class="loading-box">
            <i class="fa fa-spinner fa-spin"></i>
            Generating report...
        </div>

        <!-- Report Container -->
        <div id="reportContainer"></div>

    </div>
</div>

<script>
var _plFromDate = '';
var _plToDate   = '';

var dpOpts = {
    format: Common_Date_Format, autoclose: true,
    uiLibrary: 'bootstrap4', iconsLibrary: 'fontawesome', size: 'small'
};
$('#TxtPLFrom').datepicker(dpOpts);
$('#TxtPLTo').datepicker(dpOpts);

$(function() {
    var mn  = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var now = new Date();
    var strip = $('#monthStrip');

    strip.append('<div class="mpill" onclick="PickMonth(\'this\',this)">This Month</div>');
    for (var i = 0; i < 12; i++) {
        var d   = new Date(now.getFullYear(), now.getMonth() - i, 1);
        var lbl = mn[d.getMonth()] + ' ' + d.getFullYear();
        var fr  = '01-' + mn[d.getMonth()] + '-' + d.getFullYear();
        var to  = pad(new Date(d.getFullYear(), d.getMonth()+1, 0).getDate()) + '-' + mn[d.getMonth()] + '-' + d.getFullYear();
        strip.append('<div class="mpill" data-from="' + fr + '" data-to="' + to + '" onclick="PickPill(this)">' + lbl + '</div>');
    }
    // Auto select current month
    strip.find('.mpill').eq(1).click();
});

function pad(n) { return n < 10 ? '0' + n : '' + n; }
function fmt(n) { return '$' + parseFloat(n||0).toFixed(2); }
function fmtN(n) { return parseFloat(n||0).toLocaleString('en-SG', {minimumFractionDigits:2}); }

function PickMonth(type, el) {
    $('.mpill').removeClass('active');
    $(el).addClass('active');
    var mn  = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var now = new Date();
    _plFromDate = '01-' + mn[now.getMonth()] + '-' + now.getFullYear();
    _plToDate   = pad(new Date(now.getFullYear(), now.getMonth()+1, 0).getDate()) + '-' + mn[now.getMonth()] + '-' + now.getFullYear();
    $('#TxtPLFrom').val(_plFromDate);
    $('#TxtPLTo').val(_plToDate);
    LoadPLReport();
}

function PickPill(el) {
    $('.mpill').removeClass('active');
    $(el).addClass('active');
    _plFromDate = $(el).data('from');
    _plToDate   = $(el).data('to');
    $('#TxtPLFrom').val(_plFromDate);
    $('#TxtPLTo').val(_plToDate);
    LoadPLReport();
}

function LoadPLReport() {
    var from = $('#TxtPLFrom').val() || _plFromDate;
    var to   = $('#TxtPLTo').val()   || _plToDate;

    $('#reportContainer').empty();
    $('#summaryCards').hide();
    $('#loadingDiv').show();

    $.ajax({
        url: BaseURL + 'Reports/GetProfitLoss',
        type: 'GET',
        data: { FromDate: from, ToDate: to },
        dataType: 'json',
        success: function(r) {
            $('#loadingDiv').hide();
            if (!r.success || !r.summary) {
                $('#reportContainer').html('<div class="empty-state"><i class="fa fa-exclamation-circle"></i>No data found.</div>');
                return;
            }
            RenderPL(r.summary, r.monthly || [], from, to);
        },
        error: function() {
            $('#loadingDiv').hide();
            $('#reportContainer').html('<div class="empty-state" style="color:#e74c3c;"><i class="fa fa-times-circle"></i>Error loading report.</div>');
        }
    });
}

function RenderPL(s, monthly, from, to) {
    var rev      = parseFloat(s.TotalRevenue  || 0);
    var exp      = parseFloat(s.TotalExpenses || 0);
    var net      = parseFloat(s.NetProfit     || 0);
    var marg     = rev > 0 ? ((net / rev) * 100).toFixed(1) : 0;
    var isProfit = s.ProfitOrLoss === 'Profit';

    // Cards
    $('#sRevenue').text(fmt(rev));
    $('#sExpense').text(fmt(exp));
    $('#sNetProfit').text(fmt(Math.abs(net)));
    $('#sMargin').text(marg + ' %');
    $('#netCard').css('background', isProfit
        ? 'linear-gradient(135deg,#6c3483,#8e44ad)'
        : 'linear-gradient(135deg,#a93226,#e74c3c)');
    $('#summaryCards').show();

    var html = '<div class="row">';

    // ── LEFT: P&L Statement ────────────────────────────────
    html += '<div class="col-sm-7">';
    html += '<div class="pl-block">';

    // Revenue Section
    html += '<div class="pl-section-hdr"><i class="fa fa-arrow-circle-up"></i> Revenue</div>';
    html += plRow('Job Cash Collections',     s.JobCashRevenue,        'fa-money-bill-wave', '#27ae60');
    html += plRow('Job Credit Collections',   s.JobCreditRevenue,      'fa-credit-card',     '#27ae60');
    html += plRow('Invoice Cash Payments',    s.InvoiceCashRevenue,    'fa-file-invoice',    '#27ae60');
    html += plRow('Invoice Account Payments', s.InvoiceAccountRevenue, 'fa-university',      '#27ae60');
    html += plSubtotal('Total Revenue', rev, '#27ae60');

    html += '<div class="pl-divider"></div>';

    // Expense Section
    html += '<div class="pl-section-hdr"><i class="fa fa-arrow-circle-down"></i> Expenses</div>';
    html += plRow('Driver Expenses',    s.DriverExpenses,  'fa-user',     '#e74c3c');
    html += plRow('Company Expenses',   s.CompanyExpenses, 'fa-building', '#e74c3c');
    html += plRow('Vehicle Maintenance',s.VehicleExpenses, 'fa-car',      '#e74c3c');
    html += plRow('Outsource Costs',    s.OutsourceCosts,  'fa-handshake','#e74c3c');
    html += plSubtotal('Total Expenses', exp, '#e74c3c');

    html += '<div class="pl-divider"></div>';

    // Net
    html += '<div class="pl-row pl-net">';
    html +=   '<div class="pl-icon"><i class="fa ' + (isProfit ? 'fa-arrow-up' : 'fa-arrow-down') + '"></i></div>';
    html +=   '<div class="pl-label">NET ' + s.ProfitOrLoss.toUpperCase() + '</div>';
    html +=   '<div class="pl-amt">' + fmt(Math.abs(net)) + '</div>';
    html += '</div>';

    html += '</div>'; // pl-block

    // Margin note
    html += '<div style="background:#f8f9fa;border:1px solid #e8e8e8;border-radius:8px;padding:12px 16px;font-size:12px;color:#555;margin-bottom:16px;">';
    html += '<i class="fa fa-info-circle" style="color:#3498db;"></i> ';
    html += '<strong>Profit Margin:</strong> ' + marg + '% &nbsp;|&nbsp; ';
    html += '<strong>Period:</strong> ' + from + ' → ' + to;
    html += '</div>';

    html += '</div>'; // col-sm-7

    // ── RIGHT: Monthly Chart + Table ──────────────────────
    html += '<div class="col-sm-5">';
    html += '<div class="pl-block">';
    html += '<div class="pl-section-hdr"><i class="fa fa-chart-bar"></i> Monthly Breakdown</div>';

    if (!monthly || monthly.length === 0) {
        html += '<div class="empty-state"><i class="fa fa-calendar-times"></i>No monthly data.</div>';
    } else {
        var maxVal = 0;
        $.each(monthly, function(i, m) {
            maxVal = Math.max(maxVal, parseFloat(m.Revenue||0), parseFloat(m.Expenses||0));
        });

        // Bar chart
        html += '<div class="chart-wrap">';
        html += '<div class="chart-legend">';
        html += '<span><span class="legend-dot" style="background:#27ae60;"></span>Revenue</span>';
        html += '<span><span class="legend-dot" style="background:#e74c3c;"></span>Expenses</span>';
        html += '</div>';
        $.each(monthly, function(i, m) {
            var rw = maxVal > 0 ? (parseFloat(m.Revenue||0)/maxVal*100) : 0;
            var ew = maxVal > 0 ? (parseFloat(m.Expenses||0)/maxVal*100) : 0;
            html += '<div class="chart-row">';
            html +=   '<div class="chart-month">' + m.MonthLabel + '</div>';
            html +=   '<div class="chart-bars">';
            html +=     '<div class="bar-rev" style="width:' + rw + '%;"></div>';
            html +=     '<div class="bar-exp" style="width:' + ew + '%;"></div>';
            html +=   '</div>';
            html +=   '<div class="chart-val">$' + fmtN(m.Revenue) + '</div>';
            html += '</div>';
        });
        html += '</div>';

        // Monthly Table
        html += '<table class="ml-tbl">';
        html += '<thead><tr><th>Month</th><th class="r">Revenue</th><th class="r">Expenses</th><th class="r">Net</th></tr></thead>';
        html += '<tbody>';
        var gR=0, gE=0, gN=0;
        $.each(monthly, function(i, m) {
            var r=parseFloat(m.Revenue||0), e=parseFloat(m.Expenses||0), n=r-e;
            gR+=r; gE+=e; gN+=n;
            html += '<tr>';
            html += '<td><strong>' + m.MonthLabel + '</strong></td>';
            html += '<td class="r" style="color:#27ae60;">$' + fmtN(r) + '</td>';
            html += '<td class="r" style="color:#e74c3c;">$' + fmtN(e) + '</td>';
            html += '<td class="r ' + (n>=0?'profit':'loss') + '">$' + fmtN(n) + '</td>';
            html += '</tr>';
        });
        html += '</tbody><tfoot><tr>';
        html += '<td>TOTAL</td>';
        html += '<td class="r">$' + fmtN(gR) + '</td>';
        html += '<td class="r">$' + fmtN(gE) + '</td>';
        html += '<td class="r ' + (gN>=0?'profit':'loss') + '">$' + fmtN(gN) + '</td>';
        html += '</tr></tfoot></table>';
    }

    html += '</div></div>'; // pl-block + col
    html += '</div>'; // row

    $('#reportContainer').html(html);
}

function plRow(label, amt, icon, color) {
    return '<div class="pl-row">' +
        '<div class="pl-icon"><i class="fa ' + icon + '" style="color:' + color + ';opacity:.6;"></i></div>' +
        '<div class="pl-label">' + label + '</div>' +
        '<div class="pl-amt" style="color:' + color + ';">$' + fmtN(amt) + '</div>' +
        '</div>';
}
function plSubtotal(label, amt, color) {
    return '<div class="pl-row pl-subtotal">' +
        '<div class="pl-icon"></div>' +
        '<div class="pl-label">' + label + '</div>' +
        '<div class="pl-amt" style="color:' + color + ';">$' + fmtN(amt) + '</div>' +
        '</div>';
}

function DownloadExcel() {
    var from = $('#TxtPLFrom').val() || _plFromDate;
    var to   = $('#TxtPLTo').val()   || _plToDate;
    window.location.href = BaseURL + 'Reports/ExportProfitLoss?FromDate=' +
        encodeURIComponent(from) + '&ToDate=' + encodeURIComponent(to);
}
</script>
</body>
</html>
