@using Transport.Repository.Resource
@{
    Layout = "";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; background: transparent; }

        /* ── Month Pills ── */
        .month-strip { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 0 8px; }
        .mpill {
            padding: 5px 14px; border-radius: 20px; border: 1px solid #dee2e6;
            cursor: pointer; font-size: 12px; font-weight: 500;
            background: #fff; color: #555; transition: all .15s; white-space: nowrap;
        }
        .mpill:hover { border-color: #3498db; color: #3498db; }
        .mpill.active { background: #3498db; border-color: #3498db; color: #fff; }

        /* ── Summary Cards ── */
        .sum-cards { display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
        .scard {
            flex: 1; min-width: 140px; border-radius: 12px; padding: 14px 16px;
            color: #fff; position: relative; overflow: hidden;
        }
        .scard::after {
            content: ''; position: absolute; right: -10px; top: -10px;
            width: 70px; height: 70px; border-radius: 50%;
            background: rgba(255,255,255,.12);
        }
        .scard .sc-icon { font-size: 22px; opacity: .85; margin-bottom: 6px; }
        .scard .sc-lbl { font-size: 10px; opacity: .8; text-transform: uppercase; letter-spacing: .6px; }
        .scard .sc-val { font-size: 20px; font-weight: 700; margin-top: 2px; }
        .sc-jobs { background: linear-gradient(135deg,#1a6fa3,#2980b9); }
        .sc-rev  { background: linear-gradient(135deg,#1a9e6e,#27ae60); }
        .sc-exp  { background: linear-gradient(135deg,#a93226,#e74c3c); }
        .sc-net  { background: linear-gradient(135deg,#6c3483,#8e44ad); }

        /* ── Vehicle Card ── */
        .veh-card {
            border: 1px solid #e0e0e0; border-radius: 12px;
            overflow: hidden; margin-bottom: 20px; background: #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
        }
        .veh-header {
            background: linear-gradient(135deg,#2c3e50,#34495e);
            color: #fff; padding: 12px 18px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .veh-header .veh-name { font-weight: 700; font-size: 15px; letter-spacing: .4px; }
        .veh-header .veh-badges { display: flex; gap: 8px; align-items: center; }
        .vbadge {
            background: rgba(255,255,255,.18); border-radius: 12px;
            padding: 3px 10px; font-size: 11px; font-weight: 600;
        }
        .vbadge.green  { background: rgba(39,174,96,.35); }
        .vbadge.red    { background: rgba(231,76,60,.35); }
        .vbadge.purple { background: rgba(142,68,173,.35); }

        /* ── Vehicle Strip Stats ── */
        .veh-strip { display: flex; background: #f8f9fa; border-bottom: 1px solid #e8e8e8; }
        .vs-item { flex: 1; padding: 10px 14px; border-right: 1px solid #e8e8e8; text-align: center; }
        .vs-item:last-child { border-right: none; }
        .vs-lbl { font-size: 10px; color: #888; text-transform: uppercase; letter-spacing: .4px; }
        .vs-val { font-size: 17px; font-weight: 700; margin-top: 3px; }

        /* ── Tabs ── */
        .vtab-bar {
            display: flex; border-bottom: 2px solid #e8e8e8;
            background: #fafafa; padding: 0 16px;
        }
        .vtab {
            padding: 10px 18px; cursor: pointer; font-size: 12px; font-weight: 600;
            color: #888; border-bottom: 2px solid transparent; margin-bottom: -2px;
            transition: all .15s;
        }
        .vtab:hover { color: #3498db; }
        .vtab.active { color: #3498db; border-bottom-color: #3498db; }
        .vtab-content { padding: 14px 16px; display: none; }
        .vtab-content.active { display: block; }

        /* ── Tables ── */
        .rep-tbl { width: 100%; border-collapse: collapse; font-size: 12px; }
        .rep-tbl th {
            background: #34495e; color: #fff; padding: 8px 10px;
            text-align: left; border: 1px solid #2c3e50; white-space: nowrap;
        }
        .rep-tbl td { padding: 7px 10px; border: 1px solid #e8e8e8; }
        .rep-tbl tr:nth-child(even) td { background: #f8f9fa; }
        .rep-tbl tfoot td {
            background: #2c3e50; color: #fff; font-weight: 700;
            border: 1px solid #1a252f;
        }
        .rep-tbl td.r { text-align: right; font-weight: 600; }
        .rep-tbl th.r { text-align: right; }
        .profit { color: #27ae60; }
        .loss   { color: #e74c3c; }

        /* Expense type badge */
        .exp-badge {
            display: inline-block; padding: 2px 8px; border-radius: 10px;
            font-size: 10px; font-weight: 600;
        }
        .exp-driver  { background: #d5e8f7; color: #1a6fa3; }
        .exp-company { background: #fde8d8; color: #a93226; }

        /* ── Loading ── */
        .loading-box {
            text-align: center; padding: 50px; color: #aaa;
        }
        .loading-box i { font-size: 28px; margin-bottom: 10px; display: block; }

        /* ── Toolbar ── */
        .tb-action { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
        .btn-dl {
            padding: 6px 14px; border: none; border-radius: 6px;
            cursor: pointer; font-size: 12px; font-weight: 600;
            display: inline-flex; align-items: center; gap: 5px;
        }
        .btn-xl  { background: #1e7e34; color: #fff; }
        .btn-pdf { background: #c0392b; color: #fff; }
        .btn-xl:hover  { background: #155724; }
        .btn-pdf:hover { background: #922b21; }

        /* empty state */
        .empty-state { text-align: center; padding: 30px; color: #bbb; }
        .empty-state i { font-size: 32px; display: block; margin-bottom: 8px; }

        @@media print {
            .no-print { display: none !important; }
            .veh-card { break-inside: avoid; }
            .vtab-bar { display: none; }
            .vtab-content { display: block !important; }
            body { font-size: 11px; }
        }
    </style>
</head>
<body>
<div class="content">
    <div class="container-fluid">

        <!-- Header -->
        <div class="card card-pd mb-3">
            <div class="card-header">
                <span style="font-size:18px;"><i class="fa fa-car"></i></span>
                <span style="font-size:18px; border-left:1px solid #ccc; padding-left:10px;">
                    Vehicle Report
                </span>
                <div style="float:right;" class="no-print tb-action">
                    <button class="btn-dl btn-xl" onclick="DownloadExcel()">
                        <i class="fa fa-file-excel"></i> Excel
                    </button>
                    <button class="btn-dl btn-pdf" onclick="window.print()">
                        <i class="fa fa-file-pdf"></i> PDF
                    </button>
                </div>
            </div>
            <div class="card-body no-print">
                <!-- Month Pills -->
                <div style="font-size:11px;color:#888;margin-bottom:4px;font-weight:600;">
                    <i class="fa fa-calendar-alt"></i> SELECT PERIOD
                </div>
                <div class="month-strip" id="monthStrip"></div>

                <!-- Filters -->
                <div class="row" style="margin-top:10px;">
                    <div class="col-sm-2">
                        <label style="font-size:11px;color:#666;">From Date</label>
                        <input type="text" id="TxtVFrom" class="form-control form-control-sm" placeholder="dd-MMM-yyyy" />
                    </div>
                    <div class="col-sm-2">
                        <label style="font-size:11px;color:#666;">To Date</label>
                        <input type="text" id="TxtVTo" class="form-control form-control-sm" placeholder="dd-MMM-yyyy" />
                    </div>
                    <div class="col-sm-2">
                        <label style="font-size:11px;color:#666;">Vehicle</label>
                        <select id="ddlVehicle" class="form-control form-control-sm">
                            <option value="">All Vehicles</option>
                        </select>
                    </div>
                    <div class="col-sm-2" style="padding-top:18px;">
                        <button class="btn btn-primary btn-sm btn-block" onclick="LoadVehicleReport()">
                            <i class="fa fa-search"></i> Generate
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="sum-cards no-print" id="summaryCards" style="display:none;">
            <div class="scard sc-jobs">
                <div class="sc-icon"><i class="fa fa-car"></i></div>
                <div class="sc-lbl">Total Jobs</div>
                <div class="sc-val" id="sTotalJobs">0</div>
            </div>
            <div class="scard sc-rev">
                <div class="sc-icon"><i class="fa fa-dollar-sign"></i></div>
                <div class="sc-lbl">Total Revenue</div>
                <div class="sc-val" id="sTotalRev">$0.00</div>
            </div>
            <div class="scard sc-exp">
                <div class="sc-icon"><i class="fa fa-receipt"></i></div>
                <div class="sc-lbl">Total Expenses</div>
                <div class="sc-val" id="sTotalExp">$0.00</div>
            </div>
            <div class="scard sc-net">
                <div class="sc-icon"><i class="fa fa-landmark"></i></div>
                <div class="sc-lbl">Net Earning</div>
                <div class="sc-val" id="sTotalNet">$0.00</div>
            </div>
        </div>

        <!-- Loading -->
        <div id="loadingDiv" style="display:none;" class="loading-box">
            <i class="fa fa-spinner fa-spin"></i>
            Loading vehicle report...
        </div>

        <!-- Report Container -->
        <div id="reportContainer"></div>

    </div>
</div>

<script>
var _allData  = {};
var _fromDate = '';
var _toDate   = '';

var dpOpts = {
    format: Common_Date_Format, autoclose: true,
    uiLibrary: 'bootstrap4', iconsLibrary: 'fontawesome', size: 'small'
};
$('#TxtVFrom').datepicker(dpOpts);
$('#TxtVTo').datepicker(dpOpts);

$(function() {
    var mn  = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var now = new Date();
    var strip = $('#monthStrip');

    strip.append('<div class="mpill" onclick="PickMonth(\'this\',this)">This Month</div>');
    for (var i = 0; i < 12; i++) {
        var d = new Date(now.getFullYear(), now.getMonth() - i, 1);
        var lbl = mn[d.getMonth()] + ' ' + d.getFullYear();
        var fr  = '01-' + mn[d.getMonth()] + '-' + d.getFullYear();
        var to  = pad(new Date(d.getFullYear(), d.getMonth()+1, 0).getDate()) + '-' + mn[d.getMonth()] + '-' + d.getFullYear();
        strip.append('<div class="mpill" data-from="' + fr + '" data-to="' + to + '" onclick="PickPill(this)">' + lbl + '</div>');
    }
    // Auto select current month
    strip.find('.mpill').eq(1).click();

    $.ajax({ type: 'GET', url: BaseURL + 'Common/Load_Vehicles', dataType: 'json',
        success: function(data) {
            $.each(data, function(i, v) {
                if (v.ID > 0) $('#ddlVehicle').append('<option value="' + v.ID + '">' + v.Name + '</option>');
            });
        }
    });
});

function pad(n) { return n < 10 ? '0' + n : '' + n; }
function fmt(n) { return '$' + parseFloat(n||0).toFixed(2); }
function fmtN(n) { return parseFloat(n||0).toLocaleString('en-SG', {minimumFractionDigits:2}); }

function PickMonth(type, el) {
    $('.mpill').removeClass('active');
    $(el).addClass('active');
    var mn  = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var now = new Date();
    if (type === 'this') {
        _fromDate = '01-' + mn[now.getMonth()] + '-' + now.getFullYear();
        _toDate   = pad(new Date(now.getFullYear(), now.getMonth()+1, 0).getDate()) + '-' + mn[now.getMonth()] + '-' + now.getFullYear();
    }
    $('#TxtVFrom').val(_fromDate);
    $('#TxtVTo').val(_toDate);
    LoadVehicleReport();
}

function PickPill(el) {
    $('.mpill').removeClass('active');
    $(el).addClass('active');
    _fromDate = $(el).data('from');
    _toDate   = $(el).data('to');
    $('#TxtVFrom').val(_fromDate);
    $('#TxtVTo').val(_toDate);
    LoadVehicleReport();
}

function LoadVehicleReport() {
    var from = $('#TxtVFrom').val() || _fromDate;
    var to   = $('#TxtVTo').val()   || _toDate;
    var vc   = $('#ddlVehicle').val() || null;

    $('#reportContainer').empty();
    $('#summaryCards').hide();
    $('#loadingDiv').show();

    $.ajax({
        url: BaseURL + 'Reports/GetVehicleReport',
        type: 'GET',
        data: { VehicleCode: vc, FromDate: from, ToDate: to },
        dataType: 'json',
        success: function(r) {
            $('#loadingDiv').hide();
            if (!r.success || !r.records || r.records.length === 0) {
                $('#reportContainer').html('<div class="empty-state"><i class="fa fa-exclamation-circle"></i>No data found for selected period.</div>');
                return;
            }
            _allData  = r;
            _fromDate = from;
            _toDate   = to;
            RenderReport(r, from, to);
        },
        error: function() {
            $('#loadingDiv').hide();
            $('#reportContainer').html('<div class="empty-state" style="color:#e74c3c;"><i class="fa fa-times-circle"></i>Error loading report.</div>');
        }
    });
}

function RenderReport(r, from, to) {
    var records = r.records || [];
    var totJobs = 0, totRev = 0, totExp = 0, totNet = 0;
    $.each(records, function(i, v) {
        totJobs += parseInt(v.TotalJobs   || 0);
        totRev  += parseFloat(v.TotalRevenue  || 0);
        totExp  += parseFloat(v.TotalExpenses || 0);
        totNet  += parseFloat(v.NetEarning    || 0);
    });

    $('#sTotalJobs').text(totJobs);
    $('#sTotalRev').text(fmt(totRev));
    $('#sTotalExp').text(fmt(totExp));
    var netEl = $('#sTotalNet');
    netEl.text(fmt(totNet));
    netEl.css('color', totNet < 0 ? '#ffcdd2' : '#fff');
    $('#summaryCards').show();

    var html = '';
    $.each(records, function(i, v) {
        var vc      = v.VehicleCode;
        var netClr  = parseFloat(v.NetEarning) >= 0 ? '#2ecc71' : '#e74c3c';
        var netCls  = parseFloat(v.NetEarning) >= 0 ? 'green' : 'red';

        html += '<div class="veh-card">';

        // Header
        html += '<div class="veh-header">';
        html +=   '<span class="veh-name"><i class="fa fa-car"></i> &nbsp;' + v.VehicleName + '</span>';
        html +=   '<div class="veh-badges">';
        html +=     '<span class="vbadge"><i class="fa fa-road"></i> ' + v.TotalJobs + ' Jobs</span>';
        html +=     '<span class="vbadge green">Rev: $' + fmtN(v.TotalRevenue) + '</span>';
        html +=     '<span class="vbadge red">Exp: $' + fmtN(v.TotalExpenses) + '</span>';
        html +=     '<span class="vbadge ' + netCls + '">Net: $' + fmtN(v.NetEarning) + '</span>';
        html +=   '</div>';
        html += '</div>';

        // Strip stats
        html += '<div class="veh-strip">';
        html +=   '<div class="vs-item"><div class="vs-lbl">Cash</div><div class="vs-val" style="color:#2980b9;">$' + fmtN(v.TotalCash) + '</div></div>';
        html +=   '<div class="vs-item"><div class="vs-lbl">Credit</div><div class="vs-val" style="color:#e67e22;">$' + fmtN(v.TotalCredit) + '</div></div>';
        html +=   '<div class="vs-item"><div class="vs-lbl">Revenue</div><div class="vs-val" style="color:#27ae60;">$' + fmtN(v.TotalRevenue) + '</div></div>';
        html +=   '<div class="vs-item"><div class="vs-lbl">Expenses</div><div class="vs-val" style="color:#e74c3c;">$' + fmtN(v.TotalExpenses) + '</div></div>';
        html +=   '<div class="vs-item"><div class="vs-lbl">Net Earning</div><div class="vs-val" style="color:' + netClr + ';">$' + fmtN(v.NetEarning) + '</div></div>';
        html += '</div>';

        // Tabs
        html += '<div class="vtab-bar">';
        html +=   '<div class="vtab active" onclick="SwitchTab(this,' + vc + ',\'monthly\')"><i class="fa fa-calendar"></i> Monthly</div>';
        html +=   '<div class="vtab" onclick="SwitchTab(this,' + vc + ',\'expenses\')"><i class="fa fa-receipt"></i> Expenses</div>';
        html += '</div>';

        // Monthly tab
        html += '<div class="vtab-content active" id="tab_monthly_' + vc + '">';
        html +=   '<div class="loading-box" style="padding:20px;"><i class="fa fa-spinner fa-spin" style="font-size:18px;"></i> Loading...</div>';
        html += '</div>';

        // Expenses tab
        html += '<div class="vtab-content" id="tab_expenses_' + vc + '">';
        html +=   '<div class="loading-box" style="padding:20px;"><i class="fa fa-spinner fa-spin" style="font-size:18px;"></i> Loading...</div>';
        html += '</div>';

        html += '</div>'; // veh-card

        // Load monthly
        LoadMonthly(vc, from, to);
        // Load expenses
        LoadExpenses(vc, from, to);
    });

    $('#reportContainer').html(html);
}

function SwitchTab(el, vc, tab) {
    var card = $(el).closest('.veh-card');
    card.find('.vtab').removeClass('active');
    card.find('.vtab-content').removeClass('active');
    $(el).addClass('active');
    card.find('#tab_' + tab + '_' + vc).addClass('active');
}

function LoadMonthly(vc, from, to) {
    $.ajax({
        url: BaseURL + 'Reports/GetVehicleMonthly',
        type: 'GET',
        data: { VehicleCode: vc, FromDate: from, ToDate: to },
        dataType: 'json',
        success: function(mr) {
            var html = '';
            if (!mr.success || !mr.records || mr.records.length === 0) {
                html = '<div class="empty-state"><i class="fa fa-calendar-times"></i>No monthly data.</div>';
            } else {
                var gJ=0,gCash=0,gCred=0,gRev=0,gExp=0,gNet=0;
                html += '<table class="rep-tbl">';
                html += '<thead><tr><th>Month</th><th class="r">Jobs</th><th class="r">Cash</th><th class="r">Credit</th><th class="r">Revenue</th><th class="r">Expenses</th><th class="r">Net Earning</th></tr></thead>';
                html += '<tbody>';
                $.each(mr.records, function(i, m) {
                    var nc = parseFloat(m.NetEarning||0) >= 0 ? 'profit' : 'loss';
                    gJ+=parseInt(m.TotalJobs||0); gCash+=parseFloat(m.TotalCash||0);
                    gCred+=parseFloat(m.TotalCredit||0); gRev+=parseFloat(m.TotalRevenue||0);
                    gExp+=parseFloat(m.TotalExpenses||0); gNet+=parseFloat(m.NetEarning||0);
                    html += '<tr>';
                    html += '<td><strong>' + m.MonthLabel + '</strong></td>';
                    html += '<td class="r">' + m.TotalJobs + '</td>';
                    html += '<td class="r">$' + fmtN(m.TotalCash) + '</td>';
                    html += '<td class="r" style="color:#e67e22;">$' + fmtN(m.TotalCredit) + '</td>';
                    html += '<td class="r" style="color:#27ae60;">$' + fmtN(m.TotalRevenue) + '</td>';
                    html += '<td class="r" style="color:#e74c3c;">$' + fmtN(m.TotalExpenses) + '</td>';
                    html += '<td class="r ' + nc + '">$' + fmtN(m.NetEarning) + '</td>';
                    html += '</tr>';
                });
                var fc = gNet >= 0 ? 'profit' : 'loss';
                html += '</tbody><tfoot><tr>';
                html += '<td>TOTAL</td><td class="r">' + gJ + '</td>';
                html += '<td class="r">$' + fmtN(gCash) + '</td><td class="r">$' + fmtN(gCred) + '</td>';
                html += '<td class="r">$' + fmtN(gRev) + '</td><td class="r">$' + fmtN(gExp) + '</td>';
                html += '<td class="r ' + fc + '">$' + fmtN(gNet) + '</td>';
                html += '</tr></tfoot></table>';
            }
            $('#tab_monthly_' + vc).html(html);
        }
    });
}

function LoadExpenses(vc, from, to) {
    $.ajax({
        url: BaseURL + 'Reports/GetVehicleExpenseDetails',
        type: 'GET',
        data: { VehicleCode: vc, FromDate: from, ToDate: to },
        dataType: 'json',
        success: function(er) {
            var html = '';
            if (!er.success || !er.records || er.records.length === 0) {
                html = '<div class="empty-state"><i class="fa fa-receipt"></i>No expenses for this vehicle.</div>';
            } else {
                var total = 0;
                html += '<table class="rep-tbl">';
                html += '<thead><tr><th>Date</th><th>Type</th><th>Category</th><th>Driver / By</th><th>Remarks</th><th class="r">Amount</th></tr></thead>';
                html += '<tbody>';
                $.each(er.records, function(i, e) {
                    total += parseFloat(e.Amount || 0);
                    var typeBadge = e.ExpenseType === 'Driver'
                        ? '<span class="exp-badge exp-driver">Driver</span>'
                        : '<span class="exp-badge exp-company">Company</span>';
                    html += '<tr>';
                    html += '<td>' + e.DisplayExpenseDate + '</td>';
                    html += '<td>' + typeBadge + '</td>';
                    html += '<td>' + e.Category + '</td>';
                    html += '<td>' + (e.PersonName || '&mdash;') + '</td>';
                    html += '<td>' + (e.Remarks || '&mdash;') + '</td>';
                    html += '<td class="r" style="color:#e74c3c;">$' + fmtN(e.Amount) + '</td>';
                    html += '</tr>';
                });
                html += '</tbody><tfoot><tr>';
                html += '<td colspan="5"><strong>TOTAL EXPENSES</strong></td>';
                html += '<td class="r">$' + fmtN(total) + '</td>';
                html += '</tr></tfoot></table>';
            }
            $('#tab_expenses_' + vc).html(html);
        },
        error: function() {
            $('#tab_expenses_' + vc).html('<div class="empty-state" style="color:#e74c3c;"><i class="fa fa-times-circle"></i>Error loading expenses.</div>');
        }
    });
}

function DownloadExcel() {
    var from = $('#TxtVFrom').val() || _fromDate;
    var to   = $('#TxtVTo').val()   || _toDate;
    var vc   = $('#ddlVehicle').val() || '';
    window.location.href = BaseURL + 'Reports/ExportVehicleReport?VehicleCode=' + vc +
        '&FromDate=' + encodeURIComponent(from) + '&ToDate=' + encodeURIComponent(to);
}
</script>
</body>
</html>
